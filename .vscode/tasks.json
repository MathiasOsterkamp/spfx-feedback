{
  "version": "2.0.0",
  "tasks": [
    {
      // Started automatically before debugging (preLaunchTask in launch.json) and
      // keeps running afterwards. Stop it with "Tasks: Terminate Task".
      // --locale: language of the UI texts (loc/*.js) in debug mode; without it SPFx serves only en-us.
      "label": "gulp serve",
      "type": "shell",
      "command": "npx gulp serve --nobrowser --locale=de-de",
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "gulp-serve",
        // SPFx 1.4.1 prints compiler errors relative to the project:
        // "Error - typescript - src\extensions\feedback\x.ts(9,6): error TS2742: ..."
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "Error - (?:\\[)?(?:typescript|tsc)(?:\\])? - (.+)\\((\\d+),(\\d+)\\): error (TS\\d+): (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting (gulp|subtask 'typescript')",
          "endsPattern": "Finished subtask 'reload'"
        }
      }
    }
  ]
}
